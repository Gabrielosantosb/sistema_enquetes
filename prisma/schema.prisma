generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusEnquete {
  NAO_INICIADO
  INICIADO
  EM_ANDAMENTO
  FINALIZADO
}

model Enquete {
  id           String        @id @default(uuid()) @db.Uuid
  pergunta     String
  dataInicio   DateTime      @db.Timestamptz(3)
  dataFim      DateTime      @db.Timestamptz(3)
  status       StatusEnquete @default(NAO_INICIADO)
  criadoEm     DateTime      @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime      @updatedAt @db.Timestamptz(3)
  opcoes       Opcao[]
  votos        Voto[]

  @@index([status])
}

model Opcao {
  id        String  @id @default(uuid()) @db.Uuid
  texto     String
  enquete   Enquete @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  enqueteId String  @db.Uuid
  votos     Voto[]

  @@unique([enqueteId, texto])
  @@index([enqueteId])
}

model Voto {
  id        String   @id @default(uuid()) @db.Uuid
  opcao     Opcao    @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  opcaoId   String   @db.Uuid
  enquete   Enquete  @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  enqueteId String   @db.Uuid
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  @@index([enqueteId])
  @@index([opcaoId])
}
